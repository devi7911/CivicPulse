# Supabase project (Project Settings > API). The publishable key is safe to ship to browsers.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx

# Cloudflare Turnstile site key (free). Put the matching secret key in
# Supabase > Authentication > Attack Protection > CAPTCHA. Leave empty to disable.
VITE_TURNSTILE_SITE_KEY=

# Google sign-in. Set to true only after adding the Google client ID and secret in
# Supabase > Authentication > Providers > Google. Never put the client secret in this file.
VITE_AUTH_GOOGLE=false

# Ads marketplace: payment page advertisers use after approval (e.g. a Razorpay/UPI payment link).
# Admins confirm the payment reference in Admin > Ad review. Leave empty to send links manually.
VITE_ADS_PAYMENT_URL=

# Shown on the Privacy and Terms pages (Grievance Officer contact, required in India).
VITE_CONTACT_EMAIL=privacy@your-domain.example
VITE_OPERATOR_NAME=The CivicPulse team

# Optional: version label attached to error reports, e.g. the git commit.
VITE_RELEASE=

# Optional. Where the admin dashboard's "Open ticketing tool" button goes. Leave empty to use
# CivicPulse's own ticket queue (/admin?tab=issues). Use a full https:// link for an external tool.
VITE_TICKETING_URL=
